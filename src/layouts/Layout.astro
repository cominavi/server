---
import "../index.css";

interface Props {
  description?: string;
  lang?: string;
  title?: string;
}

const {
  description = "コミナビは、カタログの予習からサークル検索、会場マップ、ルートづくりまでをつなぐコミケ非公式ナビゲーションアプリです。",
  lang = "ja",
  title = "コミナビ",
} = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&display=swap"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <!--
    THESIS: ComiNavi turns preparation into a continuous route to the creator; it refuses the generic app-landing card stack.
    OWN-WORLD: White and cool-neutral fields, #A3D21B action green, rounded Japanese type, hairlines, capsules, and oversized ambient Lucide symbols.
    STORY: Visitors see the preparation-to-venue relay, understand real capabilities, then choose the next action; invite recipients verify context and continue in the app.
    FIRST VIEWPORT: A large left-anchored promise meets a solid route line and open action states; the primary action sits directly beneath the promise.
    FORM: Continuous focused-action route, approved composition 3, seed d17f1c66.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <svg class="icon-sprite" aria-hidden="true">
      <defs>
        <symbol id="icon-compass" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"></circle>
          <polygon
            points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"
          ></polygon>
        </symbol>
        <symbol id="icon-users" viewBox="0 0 24 24">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </symbol>
        <symbol id="icon-triangle-alert" viewBox="0 0 24 24">
          <path
            d="m21.73 18-8-14a2 2 0 0 0-3.46 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"
          ></path>
          <path d="M12 9v4"></path>
          <path d="M12 17h.01"></path>
        </symbol>
        <symbol id="icon-arrow-right" viewBox="0 0 24 24">
          <path d="M5 12h14"></path>
          <path d="m13 6 6 6-6 6"></path>
        </symbol>
        <symbol id="icon-external-link" viewBox="0 0 24 24">
          <path d="M15 3h6v6"></path>
          <path d="M10 14 21 3"></path>
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
          ></path>
        </symbol>
        <symbol id="icon-clock" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </symbol>
        <symbol id="icon-calendar-days" viewBox="0 0 24 24">
          <path d="M8 2v4"></path>
          <path d="M16 2v4"></path>
          <rect width="18" height="18" x="3" y="4" rx="2"></rect>
          <path d="M3 10h18"></path>
          <path d="M8 14h.01"></path>
          <path d="M12 14h.01"></path>
          <path d="M16 14h.01"></path>
          <path d="M8 18h.01"></path>
          <path d="M12 18h.01"></path>
        </symbol>
        <symbol id="icon-shield-check" viewBox="0 0 24 24">
          <path d="M20 13c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V5l8-3 8 3z"></path>
          <path d="m9 12 2 2 4-4"></path>
        </symbol>
        <symbol id="icon-smartphone" viewBox="0 0 24 24">
          <rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect>
          <path d="M12 18h.01"></path>
        </symbol>
        <symbol id="icon-route" viewBox="0 0 24 24">
          <circle cx="6" cy="19" r="3"></circle>
          <path d="M9 19h5.5a3.5 3.5 0 0 0 0-7h-5a3.5 3.5 0 0 1 0-7H15"></path>
          <circle cx="18" cy="5" r="3"></circle>
        </symbol>
        <symbol id="icon-search" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </symbol>
        <symbol id="icon-bookmark" viewBox="0 0 24 24">
          <path d="M19 21 12 16l-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
        </symbol>
        <symbol id="icon-list-checks" viewBox="0 0 24 24">
          <path d="m3 7 2 2 4-4"></path>
          <path d="M13 6h8"></path>
          <path d="m3 17 2 2 4-4"></path>
          <path d="M13 18h8"></path>
        </symbol>
        <symbol id="icon-navigation" viewBox="0 0 24 24">
          <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
        </symbol>
        <symbol id="icon-sparkles" viewBox="0 0 24 24">
          <path
            d="m12 3-1.9 5.1a2 2 0 0 1-1.2 1.2L4 11l4.9 1.7a2 2 0 0 1 1.2 1.2L12 19l1.9-5.1a2 2 0 0 1 1.2-1.2L20 11l-4.9-1.7a2 2 0 0 1-1.2-1.2z"
          ></path>
        </symbol>
      </defs>
    </svg>
    <slot />
  </body>
</html>

{
  "name": "cominavi-web",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "typegen": "wrangler types",
    "dev": "pnpm typegen && astro dev",
    "start": "pnpm dev",
    "build": "pnpm openapi:check && pnpm typegen && astro check && astro build",
    "check": "pnpm openapi:check && astro check",
    "test": "tsx --test tests/*.test.ts",
    "catalog:import": "tsx tools/catalog-import.ts",
    "catalog:publish": "tsx tools/publish-catalog.ts",
    "catalog:refresh": "tsx tools/run-catalog-refresh.ts",
    "openapi:generate": "tsx tools/generate-openapi.ts --output openapi/cominavi-openapi.json",
    "openapi:check": "tsx tools/generate-openapi.ts --output openapi/cominavi-openapi.json --check",
    "fixture:automerge": "tsx tools/generate-automerge-v1-fixture.ts --write",
    "seed:c108": "tsx tools/generate-realtime-seed.ts",
    "deploy": "pnpm build && wrangler deploy",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "@astrojs/react": "^6.0.2",
    "@automerge/automerge": "3.2.6",
    "@orpc/contract": "^1.15.0",
    "@orpc/openapi": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@orpc/zod": "^1.15.0",
    "astro": "^7.1.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^5.20260721.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "4.19.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.112.0"
  }
}
